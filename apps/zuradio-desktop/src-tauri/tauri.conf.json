{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zuradio",
  "version": "0.1.0",
  "identifier": "com.georgefejer.zuradio",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "img-src": "'self'",
        "style-src": "'self'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Local-first music player and private radio bridge",
    "longDescription": "Zuradio turns a computer into a private music library, local player, and password-protected WebRTC radio source that broadcasts while the desktop app is open.",
    "copyright": "Copyright © 2026 George Fejer",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": {
      "../../../web/dist/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
