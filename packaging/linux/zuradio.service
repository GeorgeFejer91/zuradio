[Unit]
Description=Zuradio local music authority
After=network-online.target graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/lib/zuradio/zuradio --data-dir %h/.local/share/zuradio serve --music %h/Musik --web-root %h/.local/lib/zuradio/web --no-open --companion-url https://georgefejer91.github.io/zuradio
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/Musik %h/.local/lib/zuradio
ReadWritePaths=%h/.local/share/zuradio
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
